# ============================================================================
# TradingAgents-TW Secure Edition v1.0 — Prod 環境設定範本
# ============================================================================
#
# 📌 用途：docker-compose.prod.yml 透過 env_file: .env.prod 載入
#
# 📌 使用方式：
#   1. cp .env.prod.example .env.prod
#   2. 用 secret-產生指令逐個填值（千萬不要與 dev .env 共用）
#   3. chmod 600 .env.prod
#   4. 永遠不要把 .env.prod 提交到 git（已在 .gitignore）
#
# 📌 Secret 產生指令：
#    python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#    或：python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================


# ── 應用層（prod 必填） ────────────────────────────
APP_ENV=prod
APP_VERSION=1.1.0
LOG_LEVEL=INFO
LOG_FORMAT=json
BUILD_VERSION=latest                          # docker image tag（CI 可覆寫）

# 對外 host（前端 NEXT_PUBLIC_WS_URL = wss://<PUBLIC_HOST>）
PUBLIC_HOST=tradingagents.local
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

ADMIN_EMAIL=admin@yourdomain.tw               # ⚠️ 改成自己的（用於 SEC EDGAR UA + 第一個 admin）
ADMIN_INITIAL_PASSWORD=                       # ⚠️ 隨機強密碼，登入後強制改
DEFAULT_TIMEZONE=Asia/Taipei
DEFAULT_LANG=zh-TW


# ── 安全（prod 必填） ──────────────────────────────
SECRET_KEY=                                   # 隨機 32 bytes base64（JWT 簽名 + CSRF）
SECRET_KEY_PREVIOUS=                          # 平時空；輪換期 7 天並存
DATA_ENCRYPTION_KEY=                          # 隨機 Fernet key（與 SECRET_KEY 必須不同）
CORS_ORIGINS=["https://tradingagents.local"]  # ⚠️ 改成 prod domain
CSP_PROD_ENABLED=true                         # prod 強制開啟 CSP nonce + strict-dynamic
# ⚠️ nginx 後端「必填」：否則 get_client_ip 一律回 nginx 容器內網 IP → per-IP 限流(L1/L2)
# 退化成全站共享一桶、audit 稽核 IP 全記成 nginx。TRUSTED_PROXY_HOPS=nginx→backend 跳數(通常 1)。
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1
# 密碼重置 token 一律不回傳於 HTTP 回應（避免免信箱帳號接管）；prod 由通知管道寄送。保持 false。
EXPOSE_RESET_TOKEN_IN_RESPONSE=false


# ── DB（prod 強密碼） ──────────────────────────────
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=tradingagents_tw
POSTGRES_SUPERUSER_PASSWORD=                  # 隨機 32 字元（僅 init / dump 用）
TA_MIGRATION_PASSWORD=                        # 隨機 32 字元（alembic）
TA_SERVICE_RW_PASSWORD=                       # 隨機 32 字元（後端業務）
TA_AGENT_RO_PASSWORD=                         # 隨機 32 字元（Agent / Tool read-only）
POOL_SIZE_RW=20
POOL_SIZE_RO=30
STATEMENT_TIMEOUT_MS=30000
LOCK_TIMEOUT_MS=10000


# ── Redis ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                               # 隨機 32 字元
POOL_SIZE_REDIS=50


# ── Qdrant ────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                               # 隨機 32 字元
EMBEDDING_DIM=768


# ── 資料源 API key（prod 必填，否則 worker 跑不了） ─
FINMIND_TOKEN=                                # https://finmindtrade.com
ALPHA_VANTAGE_API_KEY=                        # https://www.alphavantage.co/support/#api-key
FINNHUB_API_KEY=                              # https://finnhub.io（可選）


# ── LLM Provider（prod 必填） ─────────────────────
GOOGLE_API_KEY=                               # https://aistudio.google.com/apikey
OPENAI_API_KEY=                               # fallback（建議）
ANTHROPIC_API_KEY=                            # fallback（建議）
LLM_DEFAULT_PROVIDER=google
LLM_DEFAULT_MODEL=gemini-2.0-flash
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-haiku-3-5-20241022
GEMINI_EMBEDDING_MODEL=text-embedding-004
LLM_MONTHLY_BUDGET_USD_DEFAULT=50.00


# ── 通知（prod 建議啟用 ≥ 1 個 channel） ──────────
DISCORD_WEBHOOK_URL=                          # Discord 頻道設定 → 整合 → Webhook（系統層級）
TELEGRAM_BOT_TOKEN=                           # @BotFather 申請
TELEGRAM_CHAT_ID=                             # @userinfobot 取得


# ── Backup / DR（Phase 19）────────────────────────
BACKUP_DIR=/c/Projects/TradingAgents/docker/backups
GPG_RECIPIENT=                                # backup GPG public key 的 user-id（如 backup@yourdomain.tw）
BACKUP_RETENTION_DAYS=30


# ============================================================================
# 📅 Prod 部署 SOP
# ============================================================================
# 1. cp .env.prod.example .env.prod && 逐欄填值
# 2. chmod 600 .env.prod
# 3. bash scripts/generate_self_signed_cert.sh   # 或用 Let's Encrypt
# 4. docker compose -f docker-compose.prod.yml up -d
# 5. 等 healthcheck（sleep 60）
# 6. make init-db   # 首次
# 7. make seed-stocks  # 首次
# 8. 開 https://<PUBLIC_HOST> → admin 登入 → 改密碼 → onboarding
# 9. 確認 LINE/Telegram 通知測試發送
# 10. crontab：02:00 backup / 06:00 slo_report
# 詳見 docs/runbooks/prod_deployment.md
# ============================================================================
