# ▌Phase 15 .env.local 範例
# 開發環境用相對路徑(走 next.config.mjs rewrites),解決跨 port cookie 共享問題

# axios baseURL,瀏覽器端用 — 預設指向 Next 自己,讓 cookie 屬於 localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1

# WebSocket 真實位址(WS 不能走 Next rewrites),dev 直連 backend
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# next.config.mjs 內部 rewrites 用 — server 端 Proxy 目標
BACKEND_INTERNAL_URL=http://localhost:8000

# 預設使用者時區(可被 users.preferred_timezone 蓋掉)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Taipei
