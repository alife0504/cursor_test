docker/backups/*.tar.gz*
docker/backups/*.gpg
docker/backups/*.enc
docker/nginx/certs/*.pem
docker/nginx/certs/*.key
!docker/nginx/certs/.gitkeep

# ── IDE ────────────────────────────────────────────
.vscode/settings.local.json
.idea/
*.swp
*.swo
*~

# ── Test artifacts ─────────────────────────────────
playwright-report/
test-results/
