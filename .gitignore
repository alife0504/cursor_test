node_modules/
.next/
*.tsbuildinfo
coverage/
.npm
.pnpm-debug.log*
.yarn-debug.log*
.yarn-error.log*

# ── Env / Secrets ──────────────────────────────────
.env
.env.local
.env.*.local
.env.prod
*.key
*.pem
*.p12
*.crt

# ── OS ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

