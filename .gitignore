backend/cov_audit.json
backend/.coverage

# ── Logs ───────────────────────────────────────────
*.log
logs/
backend.log
celery.log

# ── Python uv ──────────────────────────────────────
.uv-cache/

# ── Local override（非 git 管理） ────────────────────
*.local

# ── Claude Code worktrees（執行時臨時建立） ──────────
.claude/worktrees/

# ── Phase 19: runtime 報表（每日跑出來，不進 git） ──────
docs/slo_reports/*.json
docs/dr_drills/*.md
docs/dr_drills/*.log
# 但保留 .gitkeep 讓目錄存在
!docs/slo_reports/.gitkeep
!docs/dr_drills/.gitkeep
